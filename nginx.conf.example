# =====================================================================
#          TMS EXPRESS - NGINX REVERSE PROXY CONFIGURATION
# =====================================================================
# A placer dans /etc/nginx/sites-available/tms-express
# Puis activer avec : ln -s /etc/nginx/sites-available/tms-express /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name tms.votredomaine.mg; # Remplacer par votre domaine ou IP serveur

    # Redirection HTTP vers HTTPS (apres generation certificat certbot)
    # return 301 https://$host$request_uri;

    # Taille max des uploads (pour photos et bordereaux)
    client_max_body_size 25M;

    # 1. API Backend FastAPI
    location /api/ {
        proxy_pass http://127.0.0.1:8000/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # 2. Frontend Next.js
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
